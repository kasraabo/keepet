# Local development only; these values are not production credentials.
APP_MODE=development
DATABASE_URL=postgres://keepet:keepet_local_only@127.0.0.1:5432/keepet?sslmode=disable
PORT=8080
# Optional JSON triage override, loaded at startup:
# TRIAGE_CONFIG=/absolute/path/triage.json

# Optional Google web OAuth client. Set all three to enable the button.
# Register this exact HTTPS redirect in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://keepet.ir/auth/google/callback
# Set true on the HTTPS site behind Caddy; false for local HTTP development only.
SESSION_COOKIE_SECURE=false
